# Auto detect text files and perform LF normalization
* text=auto

# Force LF for these files (cross-platform)
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.node binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# C++ source files - use LF for consistency
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.gyp text eol=lf
*.gypi text eol=lf