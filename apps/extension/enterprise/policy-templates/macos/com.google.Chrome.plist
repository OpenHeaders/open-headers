<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Open Headers deployment policy — Google Chrome (stable), macOS.
  Place at: /Library/Managed Preferences/com.google.Chrome.plist
  MERGE these keys into your existing Chrome policy plist if you already
  manage one — this file replaces the whole domain when copied as-is.
-->
<plist version="1.0">
<dict>
  <!-- Force-install the Open Headers extension from the Chrome Web Store. -->
  <key>ExtensionInstallForcelist</key>
  <array>
    <string>ablaikadpbfblkmhpmbbnbbfjoibeejb;https://clients2.google.com/service/update2/crx</string>
  </array>
  <!-- Only needed when your fleet blocks native messaging by default
       (NativeMessagingBlocklist = *): re-allow the Open Headers
       identity-bootstrap host. -->
  <key>NativeMessagingAllowlist</key>
  <array>
    <string>io.openheaders.nm_bootstrap</string>
  </array>
</dict>
</plist>
