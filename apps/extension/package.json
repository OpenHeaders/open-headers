{
  "name": "@openheaders/extension",
  "version": "2026.8.4",
  "private": true,
  "description": "OpenHeaders browser extension for Chrome, Firefox, Edge, and Safari",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "src/background/**",
    "src/offscreen/**",
    "src/devtools/**",
    "src/sidepanel/**"
  ],
  "scripts": {
    "build": "pnpm run build:chrome && pnpm run build:firefox && pnpm run build:edge && pnpm run build:safari",
    "build:chrome": "BROWSER=chrome vite build",
    "build:firefox": "BROWSER=firefox vite build",
    "build:edge": "BROWSER=edge vite build",
    "build:safari": "BROWSER=safari vite build",
    "dev": "BROWSER=chrome vite build --watch",
    "dev:chrome": "BROWSER=chrome vite build --watch",
    "dev:firefox": "BROWSER=firefox vite build --watch",
    "dev:edge": "BROWSER=edge vite build --watch",
    "dev:safari": "BROWSER=safari vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stress": "STRESS_PROPERTY_TESTS=1 vitest run tests/unit/sync/*.property.test.ts --test-timeout=900000",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:headed": "pnpm exec playwright test --headed",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "scan:i18n": "node ../../scripts/scan.mjs src",
    "postbuild": "pnpm exec tsx config/scripts/build-report.ts",
    "release": "pnpm exec tsx config/scripts/release.ts",
    "source-zip": "pnpm exec tsx config/scripts/source-zip.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@openheaders/core": "workspace:*",
    "@openheaders/i18n": "workspace:*",
    "@openheaders/oracle": "workspace:*",
    "@openheaders/oracle-host-browser": "workspace:*",
    "@openheaders/rule-engine": "workspace:*",
    "@openheaders/ui": "workspace:*",
    "@prettier/plugin-xml": "^3.4.2",
    "allotment": "^1.20.5",
    "antd": "^6.3.5",
    "monaco-editor": "^0.55.1",
    "prettier": "^3.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-components": "^6.1.6",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^7.0.0",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "archiver": "^5.3.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "jsdom": "^29.0.1",
    "less": "^4.2.0",
    "terser": "^5.46.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "^6.14.1",
    "node-forge": "^1.3.2",
    "lodash": "^4.17.23"
  }
}
