{
  "name": "@openheaders/extension",
  "version": "5.0.0",
  "private": true,
  "description": "OpenHeaders browser extension for Chrome, Firefox, Edge, and Safari",
  "scripts": {
    "build": "pnpm run build:chrome && pnpm run build:firefox && pnpm run build:edge && pnpm run build:safari",
    "build:chrome": "BROWSER=chrome vite build",
    "build:firefox": "BROWSER=firefox vite build",
    "build:edge": "BROWSER=edge vite build",
    "build:safari": "BROWSER=safari vite build",
    "dev": "BROWSER=chrome vite build --watch",
    "dev:chrome": "BROWSER=chrome vite build --watch",
    "dev:firefox": "BROWSER=firefox vite build --watch",
    "dev:edge": "BROWSER=edge vite build --watch",
    "dev:safari": "BROWSER=safari vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:headed": "pnpm exec playwright test --headed",
    "typecheck": "tsc --noEmit",
    "postbuild": "pnpm exec tsx config/scripts/build-report.ts",
    "release": "pnpm exec tsx config/scripts/release.ts",
    "source-zip": "pnpm exec tsx config/scripts/source-zip.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openheaders/core": "workspace:*",
    "@uiw/react-codemirror": "^4.25.9",
    "allotment": "^1.20.5",
    "antd": "^6.3.5",
    "prettier": "^3.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rrweb": "^2.0.0-alpha.18",
    "rrweb-player": "^2.0.0-alpha.18",
    "styled-components": "^6.1.6",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^7.0.0",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "archiver": "^5.3.2",
    "jsdom": "^29.0.1",
    "less": "^4.2.0",
    "terser": "^5.46.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "qs": "^6.14.1",
    "node-forge": "^1.3.2",
    "lodash": "^4.17.23"
  }
}
