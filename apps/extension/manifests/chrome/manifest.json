{
  "name": "Open Headers",
  "description": "Your existing Web DevToolkit, inside a browser extension. Modify live browser requests. Manage API Collections. Team Collaboration.",
  "author": "Open Headers",
  "version": "0.0.0",
  "manifest_version": 3,
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "tabs",
    "webRequest",
    "webNavigation",
    "debugger",
    "activeTab",
    "scripting",
    "cookies",
    "browsingData",
    "windows",
    "sidePanel",
    "identity",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "background": {
    "service_worker": "js/background/index.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content/fire-bridge/index.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/content/perf-observer/index.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*.html", "*.js", "*.css", "js/*.js", "js/**/*.js", "images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "Open Open Headers popup"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' http: https: ws: wss: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; img-src 'self' data: blob:",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; child-src 'self'; connect-src 'none'"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  }
}