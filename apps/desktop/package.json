{
  "name": "@openheaders/desktop",
  "version": "2026.8.3",
  "private": true,
  "description": "OpenHeaders desktop app",
  "desktopName": "open-headers.desktop",
  "homepage": "https://openheaders.com",
  "author": "Open Headers <contact@openheaders.com>",
  "license": "Apache-2.0",
  "main": "dist-webpack/main/index.js",
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "**/workbench/settings/schema/**",
    "**/workbench/settings/categories.tsx",
    "**/workbench/components/monaco/**",
    "src/renderer/host/install-*.ts",
    "src/main/install-*.ts"
  ],
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/rebuild-native.mjs",
    "dev": "electron-vite dev",
    "build": "cross-env NODE_ENV=production electron-vite build",
    "build:dev": "cross-env NODE_ENV=development electron-vite build",
    "build:web-bundle": "pnpm -w exec turbo build --filter=@openheaders/web",
    "predist": "pnpm run build && node scripts/build/compile-license-bytecode.js && pnpm run build:web-bundle && node ../../scripts/generate-third-party-notices.mjs --out apps/desktop/dist-webpack/THIRD-PARTY-NOTICES.txt apps/desktop apps/web apps/nm-host",
    "dist": "electron-builder --publish never",
    "dist:all": "pnpm run predist && electron-builder -mwl --x64 --arm64 --publish never",
    "dist:mac": "pnpm run predist && electron-builder --mac --publish never",
    "dist:mac:beta": "pnpm run predist && electron-builder --mac dmg zip --arm64 -c.compression=store --publish never",
    "dist:mac:unsigned": "pnpm run predist && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:mac:unsigned:arm64": "pnpm run predist && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --config.mac.target=dmg --publish never",
    "dist:win": "pnpm run predist && electron-builder --win --publish never",
    "dist:win:unsigned": "pnpm run predist && cross-env WIN_CSC_LINK='' OH_WIN_SETUP_UNSIGNED=1 electron-builder --win --publish never",
    "dist:win:unsigned:beta": "pnpm run predist && cross-env WIN_CSC_LINK='' OH_WIN_SETUP_UNSIGNED=1 electron-builder --win nsis -c.compression=store --publish never",
    "dist:win:unsigned:dir": "pnpm run predist && cross-env WIN_CSC_LINK='' electron-builder --win dir --publish never",
    "dist:win:frompacked": "cross-env WIN_CSC_LINK='' electron-builder --win --prepackaged dist/win-unpacked --publish never",
    "dist:linux": "pnpm run predist && electron-builder --linux --x64 --arm64 --publish never",
    "dist:linux:beta": "pnpm run predist && electron-builder --linux AppImage deb --x64 -c.compression=store --publish never",
    "dist:linux:rpm:x64": "pnpm run predist && electron-builder --linux --x64 --config.linux.target=rpm --publish never",
    "dist:linux:rpm:arm64": "pnpm run predist && electron-builder --linux --arm64 --config.linux.target=rpm --publish never",
    "build:dmg-bg": "node scripts/build/build-dmg-background.js",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:headed": "pnpm exec playwright test --headed",
    "typecheck": "tsc --noEmit && tsc -p src/renderer/tsconfig.json --noEmit",
    "scan:i18n": "node ../../scripts/scan.mjs src",
    "clean": "rm -rf dist-webpack dist .electron-vite"
  },
  "build": {
    "appId": "io.openheaders",
    "productName": "OpenHeaders",
    "extraMetadata": {
      "name": "open-headers"
    },
    "protocols": [
      {
        "name": "OpenHeaders Protocol",
        "schemes": [
          "openheaders"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "dist-webpack/**/*"
    ],
    "asar": true,
    "compression": "normal",
    "afterSign": "./scripts/build/notarize.js",
    "afterPack": "./scripts/build/afterPackHook.js",
    "afterAllArtifactBuild": "./scripts/build/notarize-artifacts.js",
    "msiProjectCreated": "./scripts/build/msi-project-created.js",
    "extraResources": [
      {
        "from": "dev-app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "dist-webpack/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "build",
        "to": ".",
        "filter": [
          "*.png",
          "*.ico",
          "*.svg"
        ]
      },
      {
        "from": "src/renderer/images",
        "to": "images",
        "filter": [
          "*.png"
        ]
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../nm-host/dist-bun",
        "to": "nm-host"
      }
    ],
    "asarUnpack": [
      "dist-webpack/renderer/images/**/*",
      "node_modules/@openheaders/windows-foreground/**/*"
    ],
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "nativeRebuilder": "sequential",
    "extends": null,
    "removePackageScripts": true,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "include": "build/windows/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "uninstallDisplayName": "OpenHeaders ${version}",
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "msi": {
      "artifactName": "${productName}-${version}.${ext}",
      "perMachine": true,
      "runAfterFinish": false
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/mac/entitlements.mac.plist",
      "entitlementsInherit": "build/mac/entitlements.mac.plist",
      "type": "distribution",
      "notarize": false,
      "forceCodeSigning": false,
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDisplayName": "OpenHeaders",
        "CFBundleName": "OpenHeaders",
        "CFBundleIdentifier": "io.openheaders",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "OpenHeaders Protocol",
            "CFBundleURLSchemes": [
              "openheaders"
            ]
          }
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "pkg": {
      "isRelocatable": false
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility;Development;Network",
      "executableName": "open-headers",
      "syncDesktopName": true,
      "maintainer": "Open Headers <contact@openheaders.com>",
      "desktop": {
        "entry": {
          "Name": "OpenHeaders",
          "Comment": "OpenHeaders",
          "Terminal": false,
          "Categories": "Utility;Development;Network",
          "MimeType": "x-scheme-handler/openheaders"
        }
      },
      "synopsis": "Record your browser workflow. Modify HTTP Traffic. Team Workspaces. Everything local.",
      "description": "Record your browser workflow. Modify HTTP Traffic. Team Workspaces. Everything local."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "fpm": [
        "--deb-recommends=libgtk-3-0",
        "--deb-recommends=libnotify4",
        "--deb-recommends=libnss3",
        "--deb-recommends=libxss1",
        "--deb-recommends=libxtst6",
        "--deb-recommends=xdg-utils",
        "--deb-recommends=libatspi2.0-0",
        "--deb-recommends=libuuid1",
        "--deb-recommends=libsecret-1-0"
      ],
      "artifactName": "open-headers_${version}_${arch}.${ext}",
      "compression": "xz",
      "priority": "optional",
      "afterInstall": "./scripts/debian/postinst",
      "afterRemove": "./scripts/debian/postrm"
    },
    "rpm": {
      "artifactName": "open-headers-${version}.${arch}.rpm",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ],
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none",
        "--rpm-os=linux",
        "--rpm-rpmbuild-define=_binary_payload w2.xzdio",
        "--rpm-rpmbuild-define=_binary_filedigest_algorithm 2",
        "--rpm-rpmbuild-define=_source_filedigest_algorithm 2"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "OpenHeaders",
          "Comment": "OpenHeaders",
          "Categories": "Utility;Development;Network"
        }
      }
    },
    "dmg": {
      "format": "ULFO",
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 135,
          "y": 220
        },
        {
          "x": 405,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.openheaders.com/desktop/stable"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "allotment": "^1.20.5",
    "antd": "^6.3.5",
    "better-sqlite3": "^12.10.0",
    "bytenode": "^1.6.0",
    "chokidar": "^3.5.3",
    "dayjs": "^1.11.20",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.8.9",
    "glob": "^13.0.6",
    "http-proxy": "^1.18.1",
    "node-abi": "^4.26.0",
    "node-pty": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.10",
    "scheduler": "^0.27.0",
    "valibot": "^1.4.2",
    "ws": "^8.21.3",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "@openheaders/windows-foreground": "file:../../native/windows-foreground"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@electron/rebuild": "^4.0.4",
    "@octokit/rest": "^21.1.1",
    "@openheaders/core": "workspace:*",
    "@openheaders/i18n": "workspace:*",
    "@openheaders/oracle": "workspace:*",
    "@openheaders/oracle-host-node": "workspace:*",
    "@openheaders/ui": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.0.8",
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.7",
    "electron-builder-squirrel-windows": "^26.15.7",
    "electron-playwright-helpers": "^2.1.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.0",
    "less": "^4.2.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.9.3",
    "utf-8-validate": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "node-abi": "^4.26.0",
    "lodash": "^4.18.0",
    "tar": "^7.5.21"
  }
}
