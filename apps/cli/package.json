{
  "name": "@openheaders/cli",
  "version": "2026.7.0",
  "private": true,
  "description": "Open Headers command line — a client of the daemon's /mcp surface",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "oh": "./dist/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "vite build && node scripts/pack.mjs",
    "clean": "rm -rf dist dist-package"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
