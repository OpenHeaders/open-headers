{
  "name": "@openheaders/cli",
  "version": "2026.8.3",
  "private": true,
  "description": "Open Headers command line — a client of the daemon's /mcp surface",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "oh": "./dist/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "vite build && node scripts/pack.mjs",
    "pack:sea": "vite build --config vite.config.sea.ts && node scripts/pack-sea.mjs",
    "pack:bun": "node scripts/pack-bun.mjs",
    "clean": "rm -rf dist dist-package dist-sea"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*",
    "@openheaders/i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
