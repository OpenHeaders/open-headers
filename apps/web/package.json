{
  "name": "@openheaders/web",
  "version": "2026.7.0",
  "private": true,
  "description": "OpenHeaders web app — the Workbench in a browser tab, served by a daemon",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "src/host/**"
  ],
  "scripts": {
    "build": "vite build",
