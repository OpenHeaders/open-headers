    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*",
    "@openheaders/ui": "workspace:*",
    "antd": "^6.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "less": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
