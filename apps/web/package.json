{
  "name": "@openheaders/web",
  "version": "2026.7.27",
  "private": true,
  "description": "OpenHeaders web app \u2014 the Workbench in a browser tab, served by a daemon",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "src/host/**"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p src/sw/tsconfig.json --noEmit",
    "scan:i18n": "node ../../scripts/scan.mjs src",
    "clean": "rm -rf dist",
    "test:e2e": "pnpm exec playwright test"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*",
    "@openheaders/i18n": "workspace:*",
    "@openheaders/oracle": "workspace:*",
    "@openheaders/oracle-host-browser": "workspace:*",
    "@openheaders/ui": "workspace:*",
    "antd": "^6.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "less": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "@playwright/test": "^1.58.2"
  }
}
