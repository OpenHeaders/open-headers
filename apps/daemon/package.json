{
  "name": "@openheaders/daemon",
  "version": "2026.8.3",
  "private": true,
  "description": "Standalone Open Headers daemon — the headless back-end distribution of the shared boot spine",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ohd": "./dist/cli.js"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.runner.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "vite build && vite build --config vite.config.runner.ts && node scripts/pack.mjs",
    "pack:sea": "vite build --config vite.config.sea.ts && node scripts/pack-sea.mjs",
    "clean": "rm -rf dist dist-package dist-sea"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*",
    "@openheaders/oracle": "workspace:*",
    "@openheaders/oracle-host-node": "workspace:*",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "postject": "^1.0.0-alpha.6",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
