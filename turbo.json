{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-webpack/**"]
    },
    "build:chrome": {
      "dependsOn": ["^build"],
      "outputs": ["dist/chrome/**"]
    },
    "build:firefox": {
      "dependsOn": ["^build"],
      "outputs": ["dist/firefox/**"]
    },
    "build:edge": {
      "dependsOn": ["^build"],
      "outputs": ["dist/edge/**"]
    },
    "build:safari": {
      "dependsOn": ["^build"],
      "outputs": ["dist/safari/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "scan:i18n": {
      "cache": false
    },
    "lint:i18n-locales": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
