{
  "name": "@openheaders/ui",
  "version": "2026.8.2",
  "private": true,
  "description": "OpenHeaders shared UI — workbench, devtools panel, popup primitives, design-system shared components",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "**/workbench/settings/schema/**",
    "**/workbench/settings/categories.tsx",
    "**/workbench/components/monaco/**"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./workbench": {
      "import": "./src/workbench/index.ts",
      "default": "./dist/workbench/index.js"
    },
    "./workbench/settings": {
      "types": "./dist/workbench/settings/index.d.ts",
      "import": "./src/workbench/settings/index.ts",
      "default": "./dist/workbench/settings/index.js"
    },
    "./workbench/settings/schema": {
      "types": "./dist/workbench/settings/schema/index.d.ts",
      "import": "./src/workbench/settings/schema/index.ts",
      "default": "./dist/workbench/settings/schema/index.js"
    },
    "./workbench/components/template-input": {
      "types": "./dist/workbench/components/template-input/index.d.ts",
      "import": "./src/workbench/components/template-input/index.ts",
      "default": "./dist/workbench/components/template-input/index.js"
    },
    "./workbench/components/value-editors": {
      "types": "./dist/workbench/components/value-editors/index.d.ts",
      "import": "./src/workbench/components/value-editors/index.ts",
      "default": "./dist/workbench/components/value-editors/index.js"
    },
    "./workbench/components/diff-viewer": {
      "types": "./dist/workbench/components/diff-viewer/index.d.ts",
      "import": "./src/workbench/components/diff-viewer/index.ts",
      "default": "./dist/workbench/components/diff-viewer/index.js"
    },
    "./workbench/*": {
      "types": "./dist/workbench/*.d.ts",
      "import": "./src/workbench/*",
      "default": "./dist/workbench/*.js"
    },
    "./panel/host-source-map-fetcher": {
      "import": "./src/panel/host-source-map-fetcher.ts",
      "default": "./dist/panel/host-source-map-fetcher.js"
    },
    "./panel/host-cookie-jar": {
      "import": "./src/panel/host-cookie-jar.ts",
      "default": "./dist/panel/host-cookie-jar.js"
    },
    "./panel/host-storage-inspector": {
      "import": "./src/panel/host-storage-inspector.ts",
      "default": "./dist/panel/host-storage-inspector.js"
    },
    "./panel/responsive": {
      "import": "./src/panel/responsive/index.ts",
      "default": "./dist/panel/responsive/index.js"
    },
    "./panel/*": {
      "import": "./src/panel/*",
      "default": "./dist/panel/*.js"
    },
    "./popup/*": {
      "import": "./src/popup/*",
      "default": "./dist/popup/*.js"
    },
    "./context": {
      "import": "./src/context/index.ts",
      "default": "./dist/context/index.js"
    },
    "./context/*": {
      "import": "./src/context/*",
      "default": "./dist/context/*.js"
    },
    "./components/*": {
      "import": "./src/components/*",
      "default": "./dist/components/*.js"
    },
    "./shared": {
      "import": "./src/shared/index.ts",
      "default": "./dist/shared/index.js"
    },
    "./themes": {
      "import": "./src/themes/index.ts",
      "default": "./dist/themes/index.js"
    },
    "./themes/*": {
      "import": "./src/themes/*",
      "default": "./dist/themes/*.js"
    },
    "./shared/*": {
      "import": "./src/shared/*/index.ts",
      "default": "./dist/shared/*/index.js"
    },
    "./shared/*.css": "./src/shared/*.css",
    "./shared/workspace-dropdown/*": {
      "types": "./dist/shared/workspace-dropdown/*.d.ts",
      "import": "./src/shared/workspace-dropdown/*",
      "default": "./dist/shared/workspace-dropdown/*.js"
    },
    "./shared/workspace-org/*": {
      "types": "./dist/shared/workspace-org/*.d.ts",
      "import": "./src/shared/workspace-org/*",
      "default": "./dist/shared/workspace-org/*.js"
    },
    "./shared/local-tree-builder": {
      "import": "./src/shared/local-tree-builder.ts",
      "default": "./dist/shared/local-tree-builder.js"
    },
    "./shared/build-info": {
      "import": "./src/shared/build-info.ts",
      "default": "./dist/shared/build-info.js"
    },
    "./shared/table-shared": {
      "import": "./src/shared/table-shared.ts",
      "default": "./dist/shared/table-shared.js"
    },
    "./shared/frame-scheduler": {
      "import": "./src/shared/frame-scheduler.ts",
      "default": "./dist/shared/frame-scheduler.js"
    },
    "./shared/focus-dropdown-item": {
      "import": "./src/shared/focus-dropdown-item.ts",
      "default": "./dist/shared/focus-dropdown-item.js"
    },
    "./shared/merge-editor/*": {
      "import": "./src/shared/merge-editor/*.ts",
      "default": "./dist/shared/merge-editor/*.js"
    },
    "./shared/sync/*": {
      "import": "./src/shared/sync/*.ts",
      "default": "./dist/shared/sync/*.js"
    },
    "./shared/status/store": {
      "import": "./src/shared/status/store.ts",
      "default": "./dist/shared/status/store.js"
    },
    "./shared/hooks/*": {
      "import": "./src/shared/hooks/*.ts",
      "default": "./dist/shared/hooks/*.js"
    },
    "./shared/awareness/*": {
      "import": "./src/shared/awareness/*",
      "default": "./dist/shared/awareness/*.js"
    },
    "./shared/docs/sections/*": {
      "import": "./src/shared/docs/sections/*",
      "default": "./dist/shared/docs/sections/*.js"
    },
    "./shared/docs/*": {
      "import": "./src/shared/docs/*",
      "default": "./dist/shared/docs/*.js"
    },
    "./shared/info-popover": {
      "import": "./src/shared/info-popover/index.ts",
      "default": "./dist/shared/info-popover/index.js"
    },
    "./shared/info-popover/data/http-headers": {
      "import": "./src/shared/info-popover/data/http-headers/index.tsx",
      "default": "./dist/shared/info-popover/data/http-headers/index.js"
    },
    "./shared/info-popover/data/http-status": {
      "import": "./src/shared/info-popover/data/http-status/index.ts",
      "default": "./dist/shared/info-popover/data/http-status/index.js"
    },
    "./shared/info-popover/data/cookie-attributes": {
      "import": "./src/shared/info-popover/data/cookie-attributes/index.ts",
      "default": "./dist/shared/info-popover/data/cookie-attributes/index.js"
    },
    "./shared/info-popover/data/*": {
      "import": "./src/shared/info-popover/data/*",
      "default": "./dist/shared/info-popover/data/*.js"
    },
    "./shared/info-popover/*": {
      "import": "./src/shared/info-popover/*",
      "default": "./dist/shared/info-popover/*.js"
    },
    "./shared/conflicts/*": {
      "import": "./src/shared/conflicts/*",
      "default": "./dist/shared/conflicts/*.js"
    },
    "./shared/editor-shell/*": {
      "import": "./src/shared/editor-shell/*",
      "default": "./dist/shared/editor-shell/*.js"
    },
    "./shared/forms/*": {
      "import": "./src/shared/forms/*",
      "default": "./dist/shared/forms/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "scan:i18n": "node ../../scripts/scan.mjs src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/cascadia-code": "^5.2.3",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7",
    "@monaco-editor/react": "^4.7.0",
    "@openheaders/core": "workspace:*",
    "@openheaders/i18n": "workspace:*",
    "@prettier/plugin-xml": "^3.4.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "allotment": "^1.20.5",
    "antd": "^6.3.5",
    "monaco-editor": "^0.55.1",
    "prettier": "^3.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.1.6",
    "valibot": "1.4.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
