{
  "name": "@openheaders/ui",
  "version": "2026.5.0",
  "private": true,
  "description": "OpenHeaders shared UI — workbench, devtools panel, popup primitives, design-system shared components",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./workbench": {
      "import": "./src/workbench/index.ts",
      "default": "./dist/workbench/index.js"
    },
    "./panel": {
      "import": "./src/panel/index.ts",
      "default": "./dist/panel/index.js"
    },
    "./popup": {
      "import": "./src/popup/index.ts",
      "default": "./dist/popup/index.js"
    },
    "./shared": {
      "import": "./src/shared/index.ts",
      "default": "./dist/shared/index.js"
    },
    "./shared/*": {
      "import": "./src/shared/*/index.ts",
      "default": "./dist/shared/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@openheaders/core": "workspace:*",
    "allotment": "^1.20.5",
    "antd": "^6.3.5",
    "monaco-editor": "^0.55.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-components": "^6.1.6",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
