{
  "name": "@openheaders/oracle-host-browser",
  "version": "2026.8.3",
  "private": true,
  "description": "Browser host adapter for @openheaders/oracle — IndexedDB-backed sync persistence, blob storage, and platform-native live transports",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./files/idb-blob-backend": {
      "import": "./src/files/idb-blob-backend.ts",
      "default": "./dist/files/idb-blob-backend.js"
    },
    "./live/*": {
      "import": "./src/live/*.ts",
      "default": "./dist/live/*.js"
    },
    "./sync/*": {
      "import": "./src/sync/*.ts",
      "default": "./dist/sync/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*",
    "@openheaders/oracle": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
