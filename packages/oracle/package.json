{
  "name": "@openheaders/oracle",
  "version": "2026.5.0",
  "private": true,
  "description": "OpenHeaders oracle — entity-agnostic sync engine, workspace state, conflict resolution",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sync": {
      "import": "./src/sync/index.ts",
      "default": "./dist/sync/index.js"
    },
    "./sync/*": {
      "import": "./src/sync/*.ts",
      "default": "./dist/sync/*.js"
    },
    "./storage": {
      "import": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    },
    "./files": {
      "import": "./src/files/index.ts",
      "default": "./dist/files/index.js"
    },
    "./coordination": {
      "import": "./src/coordination/index.ts",
      "default": "./dist/coordination/index.js"
    },
    "./entity/*": {
      "import": "./src/entity/*.ts",
      "default": "./dist/entity/*.js"
    },
    "./live/*": {
      "import": "./src/live/*.ts",
      "default": "./dist/live/*.js"
    },
    "./workspace/*": {
      "import": "./src/workspace/*.ts",
      "default": "./dist/workspace/*.js"
    },
    "./rpc": {
      "import": "./src/rpc/index.ts",
      "default": "./dist/rpc/index.js"
    },
    "./rule-engine/*": {
      "import": "./src/rule-engine/*.ts",
      "default": "./dist/rule-engine/*.js"
    },
    "./test-run/*": {
      "import": "./src/test-run/*.ts",
      "default": "./dist/test-run/*.js"
    },
    "./tracking/*": {
      "import": "./src/tracking/*.ts",
      "default": "./dist/tracking/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  }
}
