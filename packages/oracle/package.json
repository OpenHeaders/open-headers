{
  "name": "@openheaders/oracle",
  "version": "2026.5.0",
  "private": true,
  "description": "OpenHeaders oracle — entity-agnostic sync engine, projections + mutation builders, workspace state, conflict resolution",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sync": {
      "import": "./src/sync/index.ts",
      "default": "./dist/sync/index.js"
    },
    "./sync-builders": {
      "import": "./src/sync-builders/index.ts",
      "default": "./dist/sync-builders/index.js"
    },
    "./storage": {
      "import": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    },
    "./files": {
      "import": "./src/files/index.ts",
      "default": "./dist/files/index.js"
    },
    "./coordination": {
      "import": "./src/coordination/index.ts",
      "default": "./dist/coordination/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openheaders/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "typescript": "^5.9.3"
  }
}
