{
  "name": "@openheaders/oracle-host-node",
  "version": "2026.8.3",
  "private": true,
  "description": "Node host adapter for @openheaders/oracle — SQLite-backed sync persistence, WebSocket server, file-backed host storage",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./daemon": {
      "import": "./src/daemon/index.ts",
      "default": "./dist/daemon/index.js"
    },
    "./daemon/lan-addresses": {
      "import": "./src/daemon/lan-addresses.ts",
      "default": "./dist/daemon/lan-addresses.js"
    },
    "./daemon/license-slot": {
      "import": "./src/daemon/license-slot.ts",
      "default": "./dist/daemon/license-slot.js"
    },
    "./daemon/password-verifier": {
      "import": "./src/daemon/password/password-verifier.ts",
      "default": "./dist/daemon/password/password-verifier.js"
    },
    "./host-runtime/pairing-http": {
      "import": "./src/host-runtime/pairing-http.ts",
      "default": "./dist/host-runtime/pairing-http.js"
    },
    "./host-runtime/windows-user-path": {
      "import": "./src/host-runtime/windows-user-path.ts",
      "default": "./dist/host-runtime/windows-user-path.js"
    },
    "./host-runtime/ws-server": {
      "import": "./src/host-runtime/ws-server/index.ts",
      "default": "./dist/host-runtime/ws-server/index.js"
    },
    "./host-storage": {
      "import": "./src/host-storage/index.ts",
      "default": "./dist/host-storage/index.js"
    },
    "./host-storage/*": {
      "import": "./src/host-storage/*.ts",
      "default": "./dist/host-storage/*.js"
    },
    "./files/fs-blob-backend": {
      "import": "./src/files/fs-blob-backend.ts",
      "default": "./dist/files/fs-blob-backend.js"
    },
    "./live/system-proxy": {
      "import": "./src/live/system-proxy/index.ts",
      "default": "./dist/live/system-proxy/index.js"
    },
    "./live/node-request-transport": {
      "import": "./src/live/node-request-transport.ts",
      "default": "./dist/live/node-request-transport.js"
    },
    "./live/h3-helper/helper-binary": {
      "import": "./src/live/h3-helper/helper-binary.ts",
      "default": "./dist/live/h3-helper/helper-binary.js"
    },
    "./mcp": {
      "import": "./src/mcp/index.ts",
      "default": "./dist/mcp/index.js"
    },
    "./migration": {
      "import": "./src/migration/index.ts",
      "default": "./dist/migration/index.js"
    },
    "./workspace-tree": {
      "import": "./src/workspace-tree/index.ts",
      "default": "./dist/workspace-tree/index.js"
    },
    "./sync/*": {
      "import": "./src/sync/*.ts",
      "default": "./dist/sync/*.js"
    },
    "./traffic": {
      "import": "./src/traffic/index.ts",
      "default": "./dist/traffic/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openheaders/core": "workspace:*",
    "@openheaders/oracle": "workspace:*",
    "@peculiar/x509": "^2.0.0",
    "better-sqlite3": "^12.10.0",
    "jose": "^6.2.3",
    "reflect-metadata": "^0.2.2",
    "undici": "^7.29.0",
    "valibot": "^1.4.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
