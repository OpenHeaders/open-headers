{
  "name": "@openheaders/oracle-host-node",
  "version": "2026.7.2",
  "private": true,
  "description": "Node host adapter for @openheaders/oracle — SQLite-backed sync persistence, WebSocket server, file-backed host storage",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./daemon": {
      "import": "./src/daemon/index.ts",
      "default": "./dist/daemon/index.js"
    },
    "./host-runtime/pairing-http": {
      "import": "./src/host-runtime/pairing-http.ts",
      "default": "./dist/host-runtime/pairing-http.js"
    },
    "./host-runtime/ws-server": {
      "import": "./src/host-runtime/ws-server/index.ts",
      "default": "./dist/host-runtime/ws-server/index.js"
    },
    "./host-storage": {
      "import": "./src/host-storage/index.ts",
      "default": "./dist/host-storage/index.js"
    },
    "./host-storage/*": {
      "import": "./src/host-storage/*.ts",
      "default": "./dist/host-storage/*.js"
    },
    "./files/fs-blob-backend": {
      "import": "./src/files/fs-blob-backend.ts",
      "default": "./dist/files/fs-blob-backend.js"
    },
    "./live/node-request-transport": {
      "import": "./src/live/node-request-transport.ts",
      "default": "./dist/live/node-request-transport.js"
    },
    "./mcp": {
      "import": "./src/mcp/index.ts",
      "default": "./dist/mcp/index.js"
    },
    "./sync/*": {
      "import": "./src/sync/*.ts",
      "default": "./dist/sync/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openheaders/core": "workspace:*",
    "@openheaders/oracle": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "valibot": "^1.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
