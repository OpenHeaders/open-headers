      "import": "./src/licensing/index.ts",
      "default": "./dist/licensing/index.js"
    },
    "./backends": {
      "import": "./src/backends/index.ts",
      "default": "./dist/backends/index.js"
    },
    "./utils": {
      "import": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
