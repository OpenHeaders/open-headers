{
  "name": "@openheaders/core",
  "version": "2026.5.0",
  "private": true,
  "description": "OpenHeaders core domain model — types, schemas, protocol, and shared utilities",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./protocol": {
      "import": "./src/protocol/index.ts",
      "default": "./dist/protocol/index.js"
    },
    "./schemas": {
      "import": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./utils": {
      "import": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    },
    "./variables": {
      "import": "./src/variables/index.ts",
      "default": "./dist/variables/index.js"
    },
    "./vault": {
      "import": "./src/vault/index.ts",
      "default": "./dist/vault/index.js"
    },
    "./codec/yaml": {
      "import": "./src/codec/yaml/index.ts",
      "default": "./dist/codec/yaml/index.js"
    },
    "./workspace-intent": {
      "import": "./src/workspace-intent/index.ts",
      "default": "./dist/workspace-intent/index.js"
    },
    "./workspace-export": {
      "import": "./src/workspace-export/index.ts",
      "default": "./dist/workspace-export/index.js"
    },
    "./import": {
      "import": "./src/import/index.ts",
      "default": "./dist/import/index.js"
    },
    "./files": {
      "import": "./src/files/index.ts",
      "default": "./dist/files/index.js"
    },
    "./live": {
      "import": "./src/live/index.ts",
      "default": "./dist/live/index.js"
    },
    "./oauth": {
      "import": "./src/oauth/index.ts",
      "default": "./dist/oauth/index.js"
    },
    "./scripts": {
      "import": "./src/scripts/index.ts",
      "default": "./dist/scripts/index.js"
    },
    "./totp": {
      "import": "./src/totp/index.ts",
      "default": "./dist/totp/index.js"
    },
    "./sync": {
      "import": "./src/sync/index.ts",
      "default": "./dist/sync/index.js"
    },
    "./storage": {
      "import": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    },
    "./bridge": {
      "import": "./src/bridge/index.ts",
      "default": "./dist/bridge/index.js"
    },
    "./logger": {
      "import": "./src/logger/index.ts",
      "default": "./dist/logger/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "valibot": "^1.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
