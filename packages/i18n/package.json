{
  "name": "@openheaders/i18n",
  "version": "2026.8.3",
  "private": true,
  "description": "OpenHeaders internationalization — locale registry, message catalogs, translation runtime, pseudo-locale",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./catalogs/en": {
      "import": "./src/catalogs/en/index.ts",
      "default": "./dist/catalogs/en/index.js"
    },
    "./catalogs/en/tui": {
      "import": "./src/catalogs/en/tui.ts",
      "default": "./dist/catalogs/en/tui.js"
    },
    "./runtime": {
      "import": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./types": {
      "import": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./locales": {
      "import": "./src/locales.ts",
      "default": "./dist/locales.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:i18n-locales": "node ../../scripts/lint-locales.mjs",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
