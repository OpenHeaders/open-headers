{
  "name": "@openheaders/i18n",
  "version": "2026.7.12",
  "private": true,
  "description": "OpenHeaders internationalization — locale registry, message catalogs, translation runtime, pseudo-locale",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./catalogs/en": {
      "import": "./src/catalogs/en/index.ts",
      "default": "./dist/catalogs/en/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
